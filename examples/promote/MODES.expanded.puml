@startuml MODES
state "稼働中" as running
running: accounts ; 口座ID ⇸ Account
running: audits ; 監査ID ⇸ Audit
state "縮退中" as degraded
degraded: accounts ; 口座ID ⇸ Account
degraded: audits ; 監査ID ⇸ Audit
[*] --> running : accounts と audits は空
' promote: local/ACCOUNT.puml 〈開設済み〉 → 〈未開設〉
degraded --> degraded : CLOSE(口座ID) ; 口座ID ∈ dom accounts ∧ accounts(口座ID) ∈ 〈開設済み〉 ∧ balance が 0 ; accounts' = {口座ID} ⩤ accounts ∧ audits' = audits
' promote: local/ACCOUNT.puml 〈開設済み〉 → 〈凍結中〉
degraded --> degraded : FREEZE(口座ID, 理由) ; 口座ID ∈ dom accounts ∧ accounts(口座ID) ∈ 〈開設済み〉 ; accounts' = accounts ⊕ {口座ID ↦ 〈凍結中〉} ∧ reason は 理由 ∧ audits' = audits
' promote: local/ACCOUNT.puml 〈未開設〉 → 〈開設済み〉
degraded --> degraded : OPEN(口座ID) ; 口座ID ∉ dom accounts ; accounts' = accounts ∪ {口座ID ↦ 〈開設済み〉} ∧ balance は 0 ∧ audits' = audits
degraded --> running : RECOVER ; true ; accounts' = accounts ∧ audits' = audits
' promote: local/ACCOUNT.puml 〈凍結中〉 → 〈開設済み〉
degraded --> degraded : UNFREEZE(口座ID) ; 口座ID ∈ dom accounts ∧ accounts(口座ID) ∈ 〈凍結中〉 ; accounts' = accounts ⊕ {口座ID ↦ 〈開設済み〉} ∧ audits' = audits
' promote: local/AUDIT.puml 〈報告済み〉 → 〈未着手〉
running --> running : AUDIT-ARCHIVE(監査ID) ; 監査ID ∈ dom audits ∧ audits(監査ID) ∈ 〈報告済み〉 ; audits' = {監査ID} ⩤ audits ∧ accounts' = accounts
' promote: local/AUDIT.puml 〈未着手〉 → 〈調査中〉
running --> running : AUDIT-BEGIN(監査ID, 口座ID) ; 監査ID ∉ dom audits ; audits' = audits ∪ {監査ID ↦ 〈調査中〉} ∧ target は 口座ID ∧ accounts' = accounts
' promote: local/AUDIT.puml 〈調査中〉 → 〈報告済み〉
running --> running : AUDIT-REPORT(監査ID) ; 監査ID ∈ dom audits ∧ audits(監査ID) ∈ 〈調査中〉 ; audits' = audits ⊕ {監査ID ↦ 〈報告済み〉} ∧ accounts' = accounts
' promote: local/ACCOUNT.puml 〈開設済み〉 → 〈未開設〉
running --> running : CLOSE(口座ID) ; 口座ID ∈ dom accounts ∧ accounts(口座ID) ∈ 〈開設済み〉 ∧ balance が 0 ; accounts' = {口座ID} ⩤ accounts ∧ audits' = audits
running --> degraded : DEGRADE ; true ; accounts' = accounts ∧ audits' = audits
' promote: local/ACCOUNT.puml 〈開設済み〉 → 〈凍結中〉
running --> running : FREEZE(口座ID, 理由) ; 口座ID ∈ dom accounts ∧ accounts(口座ID) ∈ 〈開設済み〉 ; accounts' = accounts ⊕ {口座ID ↦ 〈凍結中〉} ∧ reason は 理由 ∧ audits' = audits
' promote: local/ACCOUNT.puml 〈未開設〉 → 〈開設済み〉
running --> running : OPEN(口座ID) ; 口座ID ∉ dom accounts ; accounts' = accounts ∪ {口座ID ↦ 〈開設済み〉} ∧ balance は 0 ∧ audits' = audits
' promote: local/ACCOUNT.puml 〈凍結中〉 → 〈開設済み〉
running --> running : UNFREEZE(口座ID) ; 口座ID ∈ dom accounts ∧ accounts(口座ID) ∈ 〈凍結中〉 ; accounts' = accounts ⊕ {口座ID ↦ 〈開設済み〉} ∧ audits' = audits
@enduml
